# Non-secret defaults live in config/application.json.
# Keep only secrets and deployment-specific overrides here.
DATABASE_PATH=./data/browser_automation.db
ARTIFACTS_ROOT=./artifacts
ARTIFACT_TRASH_ROOT=./artifacts/.trash
CORS_ORIGINS=http://localhost:3000
# Optional ws:// or wss:// Chrome DevTools endpoint for server-hosted execution.
PLAYWRIGHT_CDP_ENDPOINT=
# For hosted headed mode: WebSocket URL directly to FastAPI, reachable by the worker container.
# Use wss:// outside loopback/private Docker-host development.
RUNNER_BROWSER_LOCATION=local
RUNNER_RELAY_BASE_URL=
# Private operator credential for pairing/revocation; never NEXT_PUBLIC_*.
COMPANION_ADMIN_TOKEN=
# Local-only escape hatch when Docker is intentionally unavailable. Never enable on a shared server.
ALLOW_UNSANDBOXED_EXECUTION=false

# Inject into the running backend through a local env file or server secret manager.
# A GitHub Secret alone does not reach an independently deployed server.
N8N_BEARER_TOKEN=
# Optional deployment override; local credentials use an automatically managed private key file.
# CREDENTIAL_ENCRYPTION_KEY=

# Optional deployment overrides.
BACKEND_INTERNAL_URL=
