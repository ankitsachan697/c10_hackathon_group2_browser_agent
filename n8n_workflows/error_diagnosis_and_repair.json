{
  "name": "Error Diagnosis & Adaptive Repair Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "error-diagnosis-and-repair",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "id": "webhook-trigger-repair",
      "name": "Webhook — Failure Diagnostic Ingestion"
    },
    {
      "parameters": {
        "promptType": "define",
                "text": "={{ JSON.stringify({ failure_category: $json.body.failure_category, error_excerpt: $json.body.error_excerpt, dom_excerpt: $json.body.dom_excerpt, script_excerpt: $json.body.script_excerpt, selectors: $json.body.selectors || [] }) }}",
        "options": {
                    "systemMessage": "=You diagnose eligible Playwright failures from a bounded, redacted failure packet. Never infer or emit secrets. Make the smallest safe change and preserve assertions. Return a valid JSON object only with exactly these keys: root_cause, failure_category, recommended_fix, diff_summary, repaired_script."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [480, 300],
      "id": "ai-agent-repair",
      "name": "AI Agent — Adaptive Repair"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
                    "value": "={{ $env.N8N_MODEL }}",
                    "mode": "id"
        },
        "options": {
                    "temperature": "={{ Number($env.N8N_TEMPERATURE) }}",
                    "maxTokens": "={{ Number($env.N8N_MAX_TOKENS) }}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [480, 500],
      "id": "openai-repair-model",
            "name": "Configured OpenAI Model"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.output }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 300],
      "id": "respond-webhook-repair",
      "name": "Respond with Healed Script"
    }
  ],
  "connections": {
    "Webhook — Failure Diagnostic Ingestion": {
      "main": [
        [
          {
            "node": "AI Agent — Adaptive Repair",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
        "Configured OpenAI Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent — Adaptive Repair",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent — Adaptive Repair": {
      "main": [
        [
          {
            "node": "Respond with Healed Script",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
