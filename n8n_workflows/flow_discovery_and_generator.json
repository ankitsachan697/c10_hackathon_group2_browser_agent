{
  "name": "Flow Discovery & Script Generator Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "flow-discovery-and-generator",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "id": "webhook-trigger",
      "name": "Webhook — Start Discovery & Generation"
    },
    {
      "parameters": {
        "promptType": "define",
                "text": "={{ JSON.stringify({ target_url: $json.body.target_url, objective: $json.body.objective, credentials_meta: $json.body.credentials_meta || {} }) }}",
        "options": {
                    "systemMessage": "=You generate Python Playwright journeys from explicit user requests. Never embed credentials or secrets. Prefer role, label, and stable attribute locators. Return a valid JSON object only with exactly these keys: discovered_steps (string array), selectors (object), python_script (string)."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [480, 300],
      "id": "ai-agent-generator",
      "name": "AI Agent — Script Generator"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
                    "value": "={{ $env.N8N_MODEL }}",
                    "mode": "id"
        },
        "options": {
                    "temperature": "={{ Number($env.N8N_TEMPERATURE) }}",
                    "maxTokens": "={{ Number($env.N8N_MAX_TOKENS) }}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [480, 500],
      "id": "openai-model-node",
            "name": "Configured OpenAI Model"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.output }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 300],
      "id": "respond-webhook",
      "name": "Respond to Webhook"
    }
  ],
  "connections": {
    "Webhook — Start Discovery & Generation": {
      "main": [
        [
          {
            "node": "AI Agent — Script Generator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
        "Configured OpenAI Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent — Script Generator",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent — Script Generator": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
